---
import type { CollectionEntry } from 'astro:content';
import MerchantButtons from './MerchantButtons.astro';
import StarRating from './StarRating.astro';
import { withBase } from '../lib/site';

interface Props {
  produit: CollectionEntry<'produits'>;
  rank?: number;
}

const { produit, rank } = Astro.props;
const p = produit.data;
const gallery = p.images.map((img) => ({ src: withBase(img.src), alt: img.alt }));
const cover = gallery[0];
---

<article class="flex flex-col gap-4 rounded-2xl border border-slate-200 p-5 shadow-sm sm:flex-row">
  <div class="relative shrink-0 self-center">
    {
      rank && (
        <span class="absolute -left-2 -top-2 z-10 flex h-7 w-7 items-center justify-center rounded-full bg-brand-600 text-xs font-bold text-white">
          {rank}
        </span>
      )
    }
    <button
      type="button"
      class="group relative block cursor-zoom-in rounded-xl"
      data-gallery={JSON.stringify(gallery)}
      data-gallery-index="0"
      aria-label={`Voir les photos de ${p.marque} ${p.nom}`}
    >
      <img
        src={cover.src}
        alt={cover.alt}
        loading="lazy"
        width="160"
        height="160"
        class="h-32 w-32 rounded-xl object-contain transition group-hover:opacity-80"
      />
      {
        gallery.length > 1 && (
          <span class="absolute bottom-1 right-1 rounded-full bg-black/60 px-1.5 py-0.5 text-[10px] font-semibold text-white">
            +{gallery.length - 1}
          </span>
        )
      }
    </button>
  </div>
  <div class="flex-1">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <h3 class="text-lg">{p.marque} {p.nom}</h3>
      <StarRating note={p.noteRedaction} />
    </div>
    {
      p.type === 'rafraichisseur' && (
        <span class="mt-1 inline-block rounded-full bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-800">
          Rafraîchisseur évaporatif (pas un climatiseur à compresseur)
        </span>
      )
    }
    <ul class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm text-slate-600">
      {p.puissanceBtu && <li>{p.puissanceBtu} BTU</li>}
      <li>Jusqu'à {p.surfaceConseilleeM2}</li>
      {p.niveauSonoreDb && <li>{p.niveauSonoreDb} dB</li>}
      <li>{p.reversible ? 'Réversible (chaud/froid)' : 'Froid seul'}</li>
      {p.classeEnergetique && <li>Classe {p.classeEnergetique}</li>}
    </ul>
    <div class="mt-3 grid gap-4 sm:grid-cols-2">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-emerald-700">Points forts</p>
        <ul class="mt-1 space-y-0.5 text-sm text-slate-700">
          {p.avantages.map((a) => <li>+ {a}</li>)}
        </ul>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-rose-700">Points faibles</p>
        <ul class="mt-1 space-y-0.5 text-sm text-slate-700">
          {p.inconvenients.map((i) => <li>− {i}</li>)}
        </ul>
      </div>
    </div>
    <div class="mt-4">
      <MerchantButtons nomProduit={`${p.marque} ${p.nom}`} produitId={produit.id} liens={p.liens} />
    </div>
  </div>
</article>
