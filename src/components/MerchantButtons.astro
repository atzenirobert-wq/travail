---
import { MERCHANTS, withBase, type MerchantId } from '../lib/site';

interface Props {
  nomProduit: string;
  produitId: string;
  liens: Partial<Record<MerchantId, string>>;
  size?: 'default' | 'small';
}

const { nomProduit, produitId, liens, size = 'default' } = Astro.props;
const entries = (Object.entries(liens) as [MerchantId, string | undefined][]).filter(
  ([, url]) => Boolean(url),
);
---

<!--
  Conformité affiliation : chaque lien marchand passe par une page de
  redirection interne (/go/<produit>-<marchand>/) plutôt que d'exposer
  directement l'URL d'affiliation (qui contient le tag/identifiant du
  compte). La page de redirection elle-même porte le lien réel avec
  rel="sponsored nofollow" et n'est jamais indexée. Aucun prix en dur ici :
  les prix changent en dehors de notre contrôle, le prix réel n'est
  visible que sur le site du marchand.
-->
<div class="flex flex-wrap gap-2" role="group" aria-label={`Acheter ${nomProduit}`}>
  {
    entries.map(([id]) => (
      <a
        href={withBase(`/go/${produitId}-${id}/`)}
        target="_blank"
        rel="sponsored nofollow noopener"
        class:list={[
          'inline-flex items-center justify-center rounded-lg font-semibold no-underline transition-colors',
          MERCHANTS[id].className,
          size === 'small' ? 'px-3 py-1.5 text-xs' : 'px-4 py-2.5 text-sm',
        ]}
      >
        {MERCHANTS[id].label}
        <span class="sr-only"> (nouvel onglet, lien sponsorisé)</span>
      </a>
    ))
  }
</div>
{
  entries.length === 0 && (
    <p class="text-xs text-slate-500">Aucun marchand disponible pour le moment.</p>
  )
}
