---
import { withBase } from '../lib/site';
---

<div
  id="cookie-banner"
  class="fixed inset-x-0 bottom-0 z-50 hidden border-t border-slate-200 bg-white p-4 shadow-[0_-4px_12px_rgba(0,0,0,0.08)]"
  role="dialog"
  aria-label="Consentement aux cookies"
>
  <div class="mx-auto flex max-w-6xl flex-col items-start gap-3 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-sm text-slate-700">
      Nous utilisons des cookies de mesure d'audience et, avec votre accord, des cookies
      publicitaires liés à nos partenaires marchands. Vous pouvez accepter, refuser, ou en
      savoir plus sur notre
      <a href={withBase('/politique-de-cookies/')}>politique de cookies</a>.
    </p>
    <div class="flex shrink-0 gap-2">
      <button
        id="cookie-refuse"
        type="button"
        class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50"
      >
        Refuser
      </button>
      <button
        id="cookie-accept"
        type="button"
        class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-700"
      >
        Accepter
      </button>
    </div>
  </div>
</div>

<script>
  const STORAGE_KEY = 'topclim-cookie-consent';
  const banner = document.getElementById('cookie-banner');

  if (banner && !localStorage.getItem(STORAGE_KEY)) {
    banner.classList.remove('hidden');
  }

  document.getElementById('cookie-accept')?.addEventListener('click', () => {
    localStorage.setItem(STORAGE_KEY, 'accepted');
    banner?.classList.add('hidden');
  });

  document.getElementById('cookie-refuse')?.addEventListener('click', () => {
    localStorage.setItem(STORAGE_KEY, 'refused');
    banner?.classList.add('hidden');
  });
</script>
