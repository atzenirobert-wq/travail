---
import { SITE, withBase } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  compact?: boolean;
  id?: string;
}

const {
  title = 'Le guide gratuit "Bien choisir son climatiseur mobile"',
  description = 'PDF de 12 pages : puissance BTU, consommation, pièges à éviter. Un e-mail par semaine maximum, désinscription en un clic.',
  compact = false,
  id = 'newsletter',
} = Astro.props;
---

<section
  id={id}
  class:list={[
    'rounded-2xl border border-brand-100 bg-brand-50 p-6',
    compact ? 'my-8' : 'my-12 sm:p-10',
  ]}
  aria-labelledby={`${id}-heading`}
>
  <h2 id={`${id}-heading`} class:list={[compact ? 'text-lg' : 'text-2xl']}>{title}</h2>
  <p class="mt-2 max-w-2xl text-sm text-slate-700">{description}</p>

  <!--
    TODO avant mise en ligne : remplacer SITE.newsletterFormAction (src/lib/site.ts) par
    l'URL réelle de votre prestataire d'e-mailing (Brevo, Mailchimp, etc.).
    Conformité : ce formulaire ne doit jamais contenir de lien Amazon dans les e-mails
    envoyés ensuite (interdit par les Conditions Générales du programme Amazon Associates).
  -->
  <form
    action={SITE.newsletterFormAction}
    method="post"
    class="mt-4 flex flex-col gap-3 sm:flex-row"
  >
    <label for={`${id}-email`} class="sr-only">Adresse e-mail</label>
    <input
      id={`${id}-email`}
      type="email"
      name="email"
      required
      placeholder="votre@email.fr"
      class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-sm focus:border-brand-500 focus:outline-none sm:max-w-xs"
    />
    <button
      type="submit"
      class="rounded-lg bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-brand-700"
    >
      Je reçois le guide
    </button>
  </form>
  <p class="mt-3 text-xs text-slate-500">
    En vous inscrivant, vous acceptez de recevoir nos e-mails. Voir notre
    <a href={withBase('/politique-de-confidentialite/')}>politique de confidentialité</a>.
  </p>
</section>
