---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EmailCapture from '../../components/EmailCapture.astro';
import ProductCard from '../../components/ProductCard.astro';

export async function getStaticPaths() {
  const produits = await getCollection('produits');
  return produits.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const title = `${entry.data.marque} ${entry.data.nom} : fiche complète`;
const description = `Caractéristiques, avis de la rédaction et liens marchands pour le climatiseur mobile ${entry.data.marque} ${entry.data.nom}.`;
---

<BaseLayout title={title} description={description}>
  <article class="mx-auto max-w-3xl px-4 py-10">
    <nav aria-label="Fil d'Ariane" class="mb-4 text-xs text-slate-500">
      <a href="/" class="no-underline hover:underline">Accueil</a>
      <span aria-hidden="true"> / </span>
      <a href="/comparatifs/meilleur-climatiseur-mobile/" class="no-underline hover:underline">Comparatif</a>
      <span aria-hidden="true"> / </span>
      <span>{entry.data.marque} {entry.data.nom}</span>
    </nav>

    <ProductCard produit={entry} />

    <div
      class="prose-content mt-8 max-w-none [&_p]:mt-4 [&_p]:leading-relaxed"
    >
      <Content />
    </div>

    <EmailCapture />
  </article>
</BaseLayout>
