---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page introuvable" description="Cette page n'existe pas ou plus." noindex>
  <section class="mx-auto max-w-2xl px-4 py-20 text-center">
    <h1 class="text-3xl">404 — Page introuvable</h1>
    <p class="mt-4 text-slate-600">La page que vous cherchez n'existe pas ou a été déplacée.</p>
    <a href="/" class="mt-8 inline-block text-brand-700">← Retour à l'accueil</a>
  </section>
</BaseLayout>
