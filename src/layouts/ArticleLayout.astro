---
import BaseLayout from './BaseLayout.astro';
import EmailCapture from '../components/EmailCapture.astro';

interface Props {
  title: string;
  description: string;
  publishDate: Date;
  updatedDate?: Date;
  breadcrumbLabel: string;
  showEmailCapture?: boolean;
}

const { title, description, publishDate, updatedDate, breadcrumbLabel, showEmailCapture = true } =
  Astro.props;

const dateFormatter = new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long' });
---

<BaseLayout title={title} description={description}>
  <article class="mx-auto max-w-3xl px-4 py-10">
    <nav aria-label="Fil d'Ariane" class="mb-4 text-xs text-slate-500">
      <a href="/" class="no-underline hover:underline">Accueil</a>
      <span aria-hidden="true"> / </span>
      <span>{breadcrumbLabel}</span>
    </nav>

    <h1 class="text-3xl sm:text-4xl">{title}</h1>
    <p class="mt-3 text-lg text-slate-600">{description}</p>
    <p class="mt-2 text-xs text-slate-500">
      Publié le {dateFormatter.format(publishDate)}
      {updatedDate && ` · Mis à jour le ${dateFormatter.format(updatedDate)}`}
    </p>

    {showEmailCapture && <EmailCapture compact id="newsletter-top" />}

    <div
      class="prose-content mt-8 max-w-none [&_h2]:mt-10 [&_h2]:text-2xl [&_h3]:mt-6 [&_h3]:text-xl [&_p]:mt-4 [&_p]:leading-relaxed [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:pl-6 [&_ol]:mt-4 [&_ol]:list-decimal [&_ol]:pl-6 [&_li]:mt-1 [&_a]:underline [&_table]:mt-4 [&_table]:w-full [&_table]:border-collapse [&_th]:border [&_th]:border-slate-200 [&_th]:bg-slate-50 [&_th]:p-2 [&_th]:text-left [&_td]:border [&_td]:border-slate-200 [&_td]:p-2"
    >
      <slot />
    </div>

    {showEmailCapture && <EmailCapture id="newsletter-bottom" />}
  </article>
</BaseLayout>
