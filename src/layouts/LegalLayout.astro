---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  updatedDate: Date;
}

const { title, updatedDate } = Astro.props;
const dateFormatter = new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long' });
---

<BaseLayout title={title} description={`${title} — TopClim.fr`}>
  <article class="mx-auto max-w-3xl px-4 py-10">
    <h1 class="text-3xl">{title}</h1>
    <p class="mt-2 text-xs text-slate-500">Dernière mise à jour : {dateFormatter.format(updatedDate)}</p>
    <div
      class="prose-content mt-8 max-w-none [&_h2]:mt-8 [&_h2]:text-xl [&_p]:mt-3 [&_p]:leading-relaxed [&_ul]:mt-3 [&_ul]:list-disc [&_ul]:pl-6 [&_li]:mt-1 [&_a]:underline [&_blockquote]:mt-4 [&_blockquote]:rounded-lg [&_blockquote]:border [&_blockquote]:border-amber-200 [&_blockquote]:bg-amber-50 [&_blockquote]:p-4 [&_blockquote]:text-sm [&_table]:mt-4 [&_table]:w-full [&_table]:border-collapse [&_th]:border [&_th]:border-slate-200 [&_th]:bg-slate-50 [&_th]:p-2 [&_th]:text-left [&_td]:border [&_td]:border-slate-200 [&_td]:p-2"
    >
      <slot />
    </div>
  </article>
</BaseLayout>
